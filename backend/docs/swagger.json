{
    "swagger": "2.0",
    "info": {
        "description": "DMS REST API",
        "title": "Document Management System API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/auth/login": {
            "post": {
                "security": [
                    {
                        "RefreshTokenCookie": []
                    }
                ],
                "description": "Authenticates a user with email and password. On success, sets HttpOnly cookies containing the access and refresh tokens.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Log in a user",
                "parameters": [
                    {
                        "description": "Login credentials",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_auth.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Invalid request body",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "description": "Clears the access and refresh token cookies, effectively logging the user out.",
                "tags": [
                    "auth"
                ],
                "summary": "Log out the current user",
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "security": [
                    {
                        "AccessTokenCookie": []
                    }
                ],
                "description": "Returns the profile of the currently authenticated user, identified via the access token cookie.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Get current user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_auth.UserResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "User not found",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/refresh": {
            "post": {
                "description": "Reads the refresh token from the HttpOnly cookie, validates it, and issues a new access/refresh token pair via cookies. Clears cookies on failure.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Refresh authentication tokens",
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "401": {
                        "description": "Missing or invalid refresh token",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "description": "Creates a new user account. Returns the created user profile on success.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register a new user",
                "parameters": [
                    {
                        "description": "Registration details",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_auth.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_auth.UserResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request body",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Email already in use",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/documents/": {
            "post": {
                "security": [
                    {
                        "AccessTokenCookie": []
                    }
                ],
                "description": "Uploads a new document (PDF, TXT, or DOCX). Max file size is 50MB. The document is queued for processing after upload; poll the",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "documents"
                ],
                "summary": "Upload a document",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Document file (pdf, txt, docx)",
                        "name": "document",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_document.Response"
                        }
                    },
                    "400": {
                        "description": "Missing or invalid file",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "File exceeds 50MB limit",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "Unsupported file type",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/documents/{id}": {
            "get": {
                "security": [
                    {
                        "AccessTokenCookie": []
                    }
                ],
                "description": "Returns metadata for a single document owned by the authenticated user.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "documents"
                ],
                "summary": "Get a document",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Document UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_document.Response"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Access denied",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Document not found",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "AccessTokenCookie": []
                    }
                ],
                "description": "Permanently deletes a document and its stored file. This action is irreversible.",
                "tags": [
                    "documents"
                ],
                "summary": "Delete a document",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Document UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Access denied",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Document not found",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "AccessTokenCookie": []
                    }
                ],
                "description": "Updates the name of an existing document owned by the authenticated user.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "documents"
                ],
                "summary": "Rename a document",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Document UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Updated fields",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_document.UpdateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_document.Response"
                        }
                    },
                    "400": {
                        "description": "Invalid request body",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Access denied",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Document not found",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/documents/{id}/download": {
            "get": {
                "security": [
                    {
                        "AccessTokenCookie": []
                    }
                ],
                "description": "Streams the original file as an attachment. The Content-Disposition header will contain the original filename.",
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "documents"
                ],
                "summary": "Download a document",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Document UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Access denied",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Document not found",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "bitbucket_org_HyperEther_document-management-system_internal_platform_httputil.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "error": {
                    "type": "string"
                }
            }
        },
        "internal_auth.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "internal_auth.RegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 8
                }
            }
        },
        "internal_auth.UserResponse": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                }
            }
        },
        "internal_document.DocumentStatus": {
            "type": "string",
            "enum": [
                "UPLOADED",
                "PROCESSING",
                "READY",
                "FAILED"
            ],
            "x-enum-varnames": [
                "StatusUploaded",
                "StatusProcessing",
                "StatusReady",
                "StatusFailed"
            ]
        },
        "internal_document.Response": {
            "type": "object",
            "properties": {
                "content_type": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "size": {
                    "type": "integer"
                },
                "status": {
                    "$ref": "#/definitions/internal_document.DocumentStatus"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "internal_document.UpdateRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "AccessTokenCookie": {
            "description": "Short-lived JWT access token. Set automatically by /auth/login and /auth/refresh.",
            "type": "apiKey",
            "name": "access_token",
            "in": "cookie"
        },
        "RefreshTokenCookie": {
            "description": "Long-lived JWT refresh token. HttpOnly, scoped to /api/v1/auth/refresh only.",
            "type": "apiKey",
            "name": "refresh_token",
            "in": "cookie"
        }
    }
}